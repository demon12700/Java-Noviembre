extends ../../views/main/main.pug

block content
  .row
    .col-md-12
      .d-flex.justify-content-between.align-items-center.mb-4
        h2 📊 Reportes de Sistema
        a.btn.btn-primary(href="/vistas/reportes-sistema/nuevo") ➕ Generar Reporte
      table.table.table-striped.table-bordered
        thead.table-dark
          tr
            th Fecha Generación
            th Total Animales
            th Total Dueños
            th Total Reportes
            th Observaciones
        tbody
          each reporte in reportesSistema
            tr
              td= reporte.fechaGeneracion ? new Date(reporte.fechaGeneracion).toLocaleDateString() : ''
              td= reporte.totalAnimales
              td= reporte.totalDuenos
              td= reporte.totalReportes
              td= reporte.observaciones
          else
            tr
              td.text-center(colspan="5") No hay reportes de sistema registrados.