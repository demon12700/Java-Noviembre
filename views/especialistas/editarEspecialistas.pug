extends ../../views/main/main.pug

block content
  .row.justify-content-center
    .col-md-6
      h2.mb-4 ✏️ Modificar Especialista
      form(action=`/vistas/especialistas/editar/${especialista._id}`, method="POST")
        .mb-3
          label.form-label Nombre
          input.form-control(type="text", name="nombre", value=especialista.nombre, required)
        .mb-3
          label.form-label Especialización
          input.form-control(type="text", name="especializacion", value=especialista.especializacion, required)
        .mb-3
          label.form-label Teléfono
          input.form-control(type="text", name="telefono", value=especialista.telefono, required)
        .mb-3
          label.form-label Estado
          select.form-select(name="estado", required)
            option(value="ACCESIBLE", selected=(especialista.estado === "ACCESIBLE")) ACCESIBLE
            option(value="INACCESIBLE", selected=(especialista.estado === "INACCESIBLE")) INACCESIBLE
        
        button.btn.btn-success(type="submit") Actualizar Especialista
        a.btn.btn-secondary.ms-2(href="/vistas/especialistas") Cancelar