extends ../../views/main/main.pug

block content
  .row
    .col-md-12
      .d-flex.justify-content-between.align-items-center.mb-4
        h2 🩺 Lista de Especialistas
        a.btn.btn-primary(href="/vistas/especialistas/nuevo") ➕ Agregar Especialista
      table.table.table-striped.table-bordered
        thead.table-dark
          tr
            th Nombre
            th Especialización
            th Teléfono
            th Estado
            th.text-center Acciones
        tbody
          each especialista in especialistas
            tr
              td= especialista.nombre
              td= especialista.especializacion
              td= especialista.telefono
              td= especialista.estado
              td.text-center
                a.btn.btn-warning.btn-sm.me-2(href=`/vistas/especialistas/editar/${especialista._id}`) ✏️ Editar
                form.d-inline(action=`/vistas/especialistas/eliminar/${especialista._id}`, method="POST", onsubmit="return confirm('¿Estás seguro de eliminar este registro?');")
                  button.btn.btn-danger.btn-sm(type="submit") 🗑️ Eliminar
          else
            tr
              td.text-center(colspan="4") No hay especialistas registrados.