extends ../../views/main/main.pug

block content
  .row
    .col-md-12
      .d-flex.justify-content-between.align-items-center.mb-4
        h2 Lista de Animales
        a.btn.btn-primary(href="/vistas/animales/nuevo") ➕ Agregar Animal
      table.table.table-striped.table-bordered
        thead.table-dark
          tr
            th Nombre
            th Tipo / Especie
            th Dueño
            th.text-center Acciones
        tbody
          each animal in animales
            tr
              td= animal.nombre
              td= animal.tipo
              td= animal.dueño ? animal.dueño.nombre : 'Sin dueño'
              td.text-center
                a.btn.btn-warning.btn-sm.me-2(href=`/vistas/animales/editar/${animal._id}`) ✏️ Editar
                form.d-inline(action=`/vistas/animales/eliminar/${animal._id}`, method="POST", onsubmit="return confirm('¿Estás seguro de eliminar este registro?');")
                  button.btn.btn-danger.btn-sm(type="submit") 🗑️ Eliminar
          else
            tr
              td.text-center(colspan="3") No hay animales registrados.