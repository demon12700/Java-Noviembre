doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Sistema de Veterinaria 🐾
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet")
  body.d-flex.flex-column.min-vh-100
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.mb-4
      .container
        a.navbar-brand(href="/") 🐾 Veterinaria
        button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav")
          span.navbar-toggler-icon
        #navbarNav.collapse.navbar-collapse
          ul.navbar-nav.ms-auto
            li.nav-item: a.nav-link(href="/vistas/duenos") Dueños
            li.nav-item: a.nav-link(href="/vistas/animales") Animales
            li.nav-item: a.nav-link(href="/vistas/reportes") Reportes
            li.nav-item: a.nav-link(href="/vistas/especialistas") Especialistas
            li.nav-item: a.nav-link(href="/vistas/turnos") Turnos
            li.nav-item: a.nav-link(href="/vistas/reportes-sistema") Reportes Sistema

    .container.flex-grow-1
      block content

    footer.bg-dark.text-white.text-center.py-3.mt-auto
      p.mb-0 © 2026 - Sistema de Veterinaria