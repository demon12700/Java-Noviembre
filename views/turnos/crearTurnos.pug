extends ../../views/main/main.pug

block content
  .row.justify-content-center
    .col-md-6
      h2.mb-4 📅 Registrar Nuevo Turno
      form(action="/vistas/turnos", method="POST")
        .mb-3
          label.form-label Fecha del Turno
          input.form-control(type="date", name="fechaTurno", required)
        .mb-3
          label.form-label Animal Paciente
          select.form-select(name="animal", required)
            option(value="", disabled, selected) Seleccione un animal...
            each animal in animales
              option(value=animal._id)= `${animal.nombre} (${animal.tipo})`
        .mb-3
          label.form-label Dueño Responsable
          select.form-select(name="dueno", required)
            option(value="", disabled, selected) Seleccione un dueño...
            each dueno in duenos
              option(value=dueno._id)= dueno.nombre
        .mb-3
          label.form-label Especialista Asignado
          select.form-select(name="especialista", required)
            option(value="", disabled, selected) Seleccione un especialista...
            each especialista in especialistas
              option(value=especialista._id)= `${especialista.nombre} - ${especialista.especializacion}`
        .mb-3
          label.form-label Observaciones
          textarea.form-control(name="observaciones", rows="3", placeholder="Notas adicionales...")
        
        button.btn.btn-success(type="submit") Guardar Turno
        a.btn.btn-secondary.ms-2(href="/vistas/turnos") Cancelar