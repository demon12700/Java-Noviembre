extends ../../views/main/main.pug

block content
  .row
    .col-md-12
      .d-flex.justify-content-between.align-items-center.mb-4
        h2 📅 Lista de Turnos
        a.btn.btn-primary(href="/vistas/turnos/nuevo") ➕ Agregar Turno
      table.table.table-striped.table-bordered
        thead.table-dark
          tr
            th Fecha Turno
            th Animal
            th Dueño
            th Especialista
            th Observaciones
            th.text-center Acciones
        tbody
          each turno in turnos
            tr
              td= turno.fechaTurno ? new Date(turno.fechaTurno).toLocaleDateString() : ''
              td= turno.animal ? turno.animal.nombre : 'Sin animal'
              td= turno.dueno ? turno.dueno.nombre : 'Sin dueño'
              td= turno.especialista ? turno.especialista.nombre : 'Sin especialista'
              td= turno.observaciones
              td.text-center
                form.d-inline(action=`/vistas/turnos/eliminar/${turno._id}`, method="POST", onsubmit="return confirm('¿Estás seguro de eliminar este registro?');")
                  button.btn.btn-danger.btn-sm(type="submit") 🗑️ Eliminar
          else
            tr
              td.text-center(colspan="5") No hay turnos registrados.