extends ../../views/main/main.pug

block content
  .row
    .col-md-12
      .d-flex.justify-content-between.align-items-center.mb-4
        h2 📋 Lista de Reportes Médicos
        a.btn.btn-primary(href="/vistas/reportes/nuevo") ➕ Agregar Reporte

      table.table.table-striped.table-bordered
        thead.table-dark
          tr
            th Animal
            th Dueño
            th Descripción
            th Fecha
            th.text-center Acciones
        tbody
          each reporte in reportes
            tr
              td= reporte.animal ? reporte.animal.nombre : 'Sin animal'
              td= reporte.dueño ? reporte.dueño.nombre : 'Sin dueño'
              td= reporte.contenido
              td= reporte.createdAt ? new Date(reporte.createdAt).toLocaleDateString() : ''
              td.text-center
                a.btn.btn-warning.btn-sm.me-2(href=`/vistas/reportes/editar/${reporte._id}`) ✏️ Editar
                form.d-inline(action=`/vistas/reportes/eliminar/${reporte._id}`, method="POST", onsubmit="return confirm('¿Estás seguro de eliminar este registro?');")
                  button.btn.btn-danger.btn-sm(type="submit") 🗑️ Eliminar
          else
            tr
              td.text-center(colspan="5") No hay reportes registrados.