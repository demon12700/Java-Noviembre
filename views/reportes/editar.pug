extends ../../views/main/main.pug

block content
  .row.justify-content-center
    .col-md-6
      h2.mb-4 ✏️ Modificar Reporte Médico
      form(action=`/vistas/reportes/editar/${reporte._id}`, method="POST")
        .mb-3
          label.form-label Animal Paciente
          select.form-select(name="animal", required)
            each animal in animales
              option(value=animal._id, selected=(reporte.animal && reporte.animal._id.toString() === animal._id.toString()))= `${animal.nombre} (${animal.tipo})`

        .mb-3
          label.form-label Dueño Responsable
          select.form-select(name="dueño", required)
            each dueno in duenos
              option(value=dueno._id, selected=(reporte.dueño && reporte.dueño._id.toString() === dueno._id.toString()))= dueno.nombre

        .mb-3
          label.form-label Diagnóstico / Descripción
          textarea.form-control(name="contenido", rows="4", required)= reporte.contenido

        button.btn.btn-success(type="submit") Actualizar Reporte
        a.btn.btn-secondary.ms-2(href="/vistas/reportes") Cancelar