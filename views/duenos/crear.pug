extends ../../views/main/main.pug

block content
  .row.justify-content-center
    .col-md-6
      h2.mb-4 👤 Registrar Nuevo Dueño
      form(action="/vistas/duenos", method="POST")
        .mb-3
          label.form-label Nombre
          input.form-control(type="text", name="nombre", required)
        .mb-3
          label.form-label Teléfono
          input.form-control(type="text", name="telefono", required)
        .mb-3
          label.form-label Correo Electrónico
          input.form-control(type="email", name="correo", required)
        button.btn.btn-success(type="submit") Guardar Dueño
        a.btn.btn-secondary.ms-2(href="/vistas/duenos") Cancelar