extends ../../views/main/main.pug

block content
  .row.justify-content-center
    .col-md-6
      h2.mb-4 ✏️ Modificar Dueño
      form(action=`/vistas/duenos/editar/${dueño._id}`, method="POST")
        .mb-3
          label.form-label Nombre
          input.form-control(type="text", name="nombre", value=dueño.nombre, required)
        .mb-3
          label.form-label Teléfono
          input.form-control(type="text", name="telefono", value=dueño.telefono, required)
        .mb-3
          label.form-label Correo
          input.form-control(type="email", name="correo", value=dueño.correo, required)

        button.btn.btn-success(type="submit") Actualizar Dueño
        a.btn.btn-secondary.ms-2(href="/vistas/duenos") Cancelar